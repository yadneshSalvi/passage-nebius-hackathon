# Server-only credentials. Never use a VITE_ prefix for secrets.
PASSAGE_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Qualified regional Ultra route (28 October 2026; see docs/journey-compiler.md):
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
# NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Explicit paid development routes; adding a key never switches providers.
FIREWORKS_AI_API_KEY=
FIREWORKS_AI_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_AI_MODEL=accounts/fireworks/models/nemotron-3-ultra-nvfp4
TOGETHER_AI_API_KEY=
TOGETHER_AI_BASE_URL=https://api.together.xyz/v1
TOGETHER_AI_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL
# Deliberately enable only after authorizing the provider charges.
PASSAGE_ALLOW_LIVE=false
# Local Nebius admission cap; explicit authorization is required before raising it.
PASSAGE_NEBIUS_BUDGET_USD=2
PASSAGE_PREVIEW_PORT=4103
# Optional existing compatible Chromium installation:
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/absolute/path/to/chromium
